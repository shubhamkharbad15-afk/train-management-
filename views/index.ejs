<!DOCTYPE html>
<html>
<head>
  <title>Train Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <%- include('partials/header') %>
    <div class="content">
      <h2>Welcome to Train Management System</h2>
      <p>A comprehensive railway management solution with advanced features.</p>
      
      <div style="margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">🚂 Trains</h3>
          <p style="color: white; margin: 0;">Manage train schedules and routes</p>
        </div>
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">👥 Passengers</h3>
          <p style="color: white; margin: 0;">Manage passenger information</p>
        </div>
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">🎫 Bookings</h3>
          <p style="color: white; margin: 0;">Handle ticket reservations</p>
        </div>
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">💳 Payments</h3>
          <p style="color: white; margin: 0;">Track payment transactions</p>
        </div>
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">🚃 Compartments</h3>
          <p style="color: white; margin: 0;">Manage train compartments & seats</p>
        </div>
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">🔧 Maintenance</h3>
          <p style="color: white; margin: 0;">Track maintenance records</p>
        </div>
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px; border-radius: 10px; color: white; text-align: center;">
          <h3 style="color: white; border: none; margin: 0 0 10px 0;">🔔 Notifications</h3>
          <p style="color: white; margin: 0;">Send passenger notifications</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
